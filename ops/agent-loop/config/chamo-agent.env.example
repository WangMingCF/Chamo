# Environment for the development agent's container (Synology Container Manager:
# the project's "Environment" settings, or an env_file in docker-compose).
# Keep the real file on the NAS only; never commit it.

REPO=WangMingCF/chamo
WORKDIR=/work/chamo                 # the agent's clone (a read-write volume)

# Fine-grained token, repository access: only this repository.
#   Contents: read/write · Pull requests: read/write · Issues: read/write
#   Actions: read/write (to start test-matrix runs) · Metadata: read
#   NOT Commit statuses (only the review workflow sets agent-review)
#   NOT Workflows (the agent cannot change CI or its reviewer)
#   NOT Administration
GH_TOKEN=

# Model API key for the harness, under whatever name it reads.
MODEL_API_KEY=
DEEPSEEK_API_KEY=${MODEL_API_KEY}

# Hashed private keywords (see README); mounted read-only.
CHAMO_PRIVATE_KEYWORDS=/config/private-keywords.txt

# Only needed if you use run_loop.sh as the driver:
HARNESS_CMD='your-harness run --non-interactive --prompt-stdin'
STATUS_ISSUE=
MAX_ROUNDS_PER_DAY=6
MAX_CONSECUTIVE_FAILURES=3
ROUND_TIMEOUT=14400
ROUND_INTERVAL=900
RELEASE_MODE=draft
STOP_FILE=/config/STOP
CHAMO_STATE=/config/state
