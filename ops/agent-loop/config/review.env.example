# ~chamo-review/.config/chamo-agent/review.env (mode 600). Secrets for the reviewer.
#
# A different fine-grained token, repository access: only WangMingCF/chamo.
#   Commit statuses: read/write · Pull requests: read/write · Issues: read/write
#   Contents: read · Metadata: read
GH_TOKEN=
MODEL_API_KEY=
DEEPSEEK_API_KEY=${MODEL_API_KEY}
# One review: the prompt arrives on stdin; print the review to stdout ending with
# a line "VERDICT: APPROVE" or "VERDICT: REQUEST_CHANGES". No tools, no repo access
# are needed. Prefer a different model from the developer agent.
REVIEW_CMD='your-harness ask --model deepseek-reasoner --prompt-stdin'
