[Unit]
Description=Chamo independent PR review (one pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=chamo-review
Group=chamo-review
WorkingDirectory=/home/chamo-review
Environment=PATH=/home/chamo-review/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/chamo-agent/review_prs.sh
TimeoutStartSec=2h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/chamo-review
InaccessiblePaths=-/home/chamo-agent
