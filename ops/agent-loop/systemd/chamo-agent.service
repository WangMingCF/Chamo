[Unit]
Description=Chamo self-iteration loop (developer agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chamo-agent
Group=chamo-agent
WorkingDirectory=/home/chamo-agent
Environment=PATH=/home/chamo-agent/venv/bin:/home/chamo-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/chamo-agent/run_loop.sh
Restart=on-failure
RestartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/chamo-agent
InaccessiblePaths=-/home/chamo-review

[Install]
WantedBy=multi-user.target
